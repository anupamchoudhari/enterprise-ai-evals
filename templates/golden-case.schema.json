{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Golden eval case",
  "description": "One test case for an enterprise AI feature: a single question, or a conversation with a checkpoint at each turn. Store one case per line in a .jsonl file.",
  "type": "object",
  "required": [
    "id",
    "user_context",
    "slice"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "slice": {
      "type": "string",
      "description": "Dataset slice, e.g. single_doc, conditional, unanswerable, adversarial"
    },
    "input": {
      "type": "string",
      "description": "User request, for single-question cases"
    },
    "goal": {
      "type": "string",
      "description": "For conversations: what the user is trying to get done by the end. Used by the whole-conversation judge."
    },
    "turns": {
      "type": "array",
      "description": "For conversations: each user turn in order, with what must be true of the reply at that turn. Rules in forbidden_doc_ids, canary_strings and forbidden_tool_calls apply to every turn.",
      "items": {
        "type": "object",
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "type": "string",
            "description": "What the user says at this turn"
          },
          "expected_behavior": {
            "type": "string",
            "enum": [
              "answer",
              "abstain",
              "clarify",
              "escalate",
              "refuse",
              "act",
              "act_after_confirmation"
            ]
          },
          "required_facts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_doc_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_doc_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra documents forbidden at this turn only"
          }
        }
      }
    },
    "simulated_user": {
      "type": "object",
      "description": "Optional: instead of scripted turns, a persona and goal for an LLM user simulator. Grade these with the whole-conversation judge and end state.",
      "properties": {
        "persona": {
          "type": "string"
        },
        "max_turns": {
          "type": "integer"
        }
      }
    },
    "user_context": {
      "type": "object",
      "required": [
        "persona",
        "tenant"
      ],
      "properties": {
        "persona": {
          "type": "string"
        },
        "tenant": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "object",
          "description": "Region, plan, employment type, locale, etc."
        }
      }
    },
    "expected_behavior": {
      "type": "string",
      "enum": [
        "answer",
        "abstain",
        "clarify",
        "escalate",
        "refuse",
        "act",
        "act_after_confirmation"
      ]
    },
    "reference_answer": {
      "type": "string"
    },
    "required_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_doc_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_doc_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Documents this user must never retrieve or cite. Required for any case touching restricted content."
    },
    "canary_strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_tool_calls": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "forbidden_tool_calls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_end_state": {
      "type": "object"
    },
    "gold_sql": {
      "type": "string"
    },
    "failure_modes_targeted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string",
      "description": "real_trace | ticket | incident | synthetic | expert"
    },
    "added": {
      "type": "string",
      "format": "date"
    },
    "path_rules": {
      "type": "object",
      "description": "For agents: rules about the path that must hold on every run. Judge the end state and these rules instead of matching one reference path.",
      "properties": {
        "max_steps": {
          "type": "integer"
        },
        "confirm_before": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tools that need the user's confirmation first"
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "input",
        "expected_behavior"
      ]
    },
    {
      "required": [
        "turns"
      ]
    }
  ]
}
